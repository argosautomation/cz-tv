PKG_NAME=cz-tv
PKG_VERSION=1.2
PKG_REVISION=1
PKG_DESC="Live TV guide: browse an M3U playlist on the card's own screen and play it there, or on a TV the moment an HDMI cable is plugged in (TAB to override). Point it at your own playlist - Jellyfin, Plex, an IPTV provider, an iptv-org list - or use the built-in list of open live streams. Type any letter to search; sound follows the picture, with volume on Fn+S / Fn+D and mute on Fn+A"
PKG_DEPENDS="vlc, ffmpeg, curl, pulseaudio-utils"
APP_NAME="TV"
APP_EXEC=/usr/share/APPLaunch/bin/cz-tv
APP_TERMINAL=false
APP_ICON=share/images/cz-tv.png
